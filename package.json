{
	"name": "cloudcannon-hugo",
	"type": "module",
	"version": "1.0.13",
	"description": "Generates the files necessary for a hugo site to integrate with CloudCannon CMS",
	"main": "src/index.js",
	"scripts": {
		"lint": "biome check",
		"start": "node src/index.js",
		"test": "node --test 'test/{generators,helpers,parsers}/*.test.js'",
		"test:integration": "node --test 'test/integration/*.test.js'",
		"test:all": "node --test",
		"report-coverage": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=lcov.info"
	},
	"engines": {
		"node": ">=18"
	},
	"bin": {
		"cloudcannon-hugo": "src/index.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CloudCannon/cloudcannon-hugo.git"
	},
	"contributors": [
		"Nathan Kennedy",
		"Ross Phillips"
	],
	"author": {
		"name": "CloudCannon",
		"email": "support@cloudcannon.com"
	},
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/CloudCannon/cloudcannon-hugo/issues"
	},
	"files": [
		"src"
	],
	"homepage": "https://github.com/CloudCannon/cloudcannon-hugo#readme",
	"devDependencies": {
		"@biomejs/biome": "2.5.9"
	},
	"dependencies": {
		"ansis": "^4.3.1",
		"lilconfig": "^3.1.3",
		"meow": "^14.1.0",
		"papaparse": "^5.3.1",
		"smol-toml": "^1.8.0",
		"tinyglobby": "^0.2.17",
		"yaml": "^2.9.0"
	}
}
